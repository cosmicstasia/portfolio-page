---
import SkillBadge from './SkillBadge.astro';
import { Github, ExternalLink } from 'lucide-astro';

interface Props {
  title: string;
  description: string;
  tech: string[];
  github?: string;
  live?: string;
  org?: string;
}
const { title, description, tech, github, live, org } = Astro.props;
---

<div class="project-card relative bg-mantle border border-surface0 rounded-lg p-6 flex flex-col gap-4 h-full transition-all duration-300 hover:border-mauve/50 hover:-translate-y-1 hover:shadow-lg hover:shadow-mauve/10">
  <div class="flex items-start justify-between gap-4">
    <div>
      <h3 class="font-mono text-base font-semibold text-text">{title}</h3>
      {org && <div class="font-mono text-xs text-overlay0 mt-1">{org}</div>}
    </div>
    <div class="flex items-center gap-3 shrink-0">
      {github && (
        <a href={github} target="_blank" rel="noopener noreferrer" class="text-overlay0 hover:text-text transition-colors" aria-label="GitHub repository">
          <Github size={16} />
        </a>
      )}
      {live && (
        <a href={live} target="_blank" rel="noopener noreferrer" class="text-overlay0 hover:text-text transition-colors" aria-label="Live site">
          <ExternalLink size={16} />
        </a>
      )}
    </div>
  </div>
  <p class="text-sm text-subtext leading-relaxed font-sans">{description}</p>
  <div class="flex flex-wrap gap-2 mt-auto">
    {tech.map(t => <SkillBadge name={t} />)}
  </div>
</div>

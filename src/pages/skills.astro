---
import Layout from '../layouts/Layout.astro';
import SkillBadge from '../components/SkillBadge.astro';

const categories = [
  {
    name: 'Languages',
    skills: ['Python', 'JavaScript', 'TypeScript', 'SQL', 'Bash', 'HTML/CSS'],
  },
  {
    name: 'Infrastructure & Cloud',
    skills: ['AWS EKS', 'AWS EC2', 'AWS Lambda', 'AWS S3', 'AWS SES', 'AWS IAM', 'Docker', 'Kubernetes', 'Helm', 'OpenTofu'],
  },
  {
    name: 'Frameworks & Tools',
    skills: ['FastAPI', 'Celery', 'Redis', 'Elasticsearch', 'FAISS', 'GitLab CI/CD', 'Tailscale', 'Caddy', 'NixOS'],
  },
  {
    name: 'Data & ML',
    skills: ['OpenCV', 'FAISS', 'Ollama', 'Pydantic', 'Apache Spark', 'AWS EMR'],
  },
  {
    name: 'Networking',
    skills: ['OPNsense', 'Pi-hole', 'Unbound', 'Tailscale', 'Kismet', 'Reverse Proxying'],
  },
];
---

<Layout title="Skills — Anastasia Coffman" description="Technical skills of Anastasia Coffman.">
  <section>
    <h1 class="font-mono text-sm text-overlay0 mb-10">// skills</h1>

    <div class="space-y-10">
      {categories.map(cat => (
        <div>
          <div class="font-mono text-sm text-overlay0 mb-4">
            <span class="text-surface1">// </span>{cat.name.toLowerCase()}
          </div>
          <div class="flex flex-wrap gap-2">
            {cat.skills.map(skill => <SkillBadge name={skill} />)}
          </div>
        </div>
      ))}
    </div>
  </section>
</Layout>
